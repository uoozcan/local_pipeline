/*
 * HLA Typing Pipeline Configuration
 * Multi-tool HLA typing with consensus voting
 */

params {
    // Input/Output
    input_bam       = null
    input_fastq_1   = null
    input_fastq_2   = null
    input_samplesheet = null
    outdir          = './results'

    // QC thresholds for HLA read warnings
    min_hla_reads   = 1000      // Minimum HLA reads for reliable typing
    min_read_length = 50        // Minimum average read length
    max_error_rate  = 0.05      // Maximum acceptable error rate (5%)

    // Sequence type
    // Short reads: 'dna' (WGS/WES) or 'rna' (RNA-seq)
    // Long reads : 'longreads_hifi' (PacBio CCS/HiFi) or 'longreads_ont' (Oxford Nanopore)
    //              Long-read inputs must be provided as BAM via --input_bam.
    seq_type        = 'dna'

    // Reference genome version
    reference       = 'hg38'  // hg38 or hg19

    // HLA genes to type
    hla_genes       = 'HLA-A,HLA-B,HLA-C,HLA-DRB1,HLA-DQA1,HLA-DQB1,HLA-DPA1,HLA-DPB1'

    // Tool selection (comma-separated list)
    // Available: spechla,hlahd,arcashla,optitype,xhla,hlala
    tools           = 'spechla,hlahd'

    // Enhanced QC options
    run_bamqc       = false         // Run BAMQC for comprehensive BAM quality control
    skip_qc         = false         // Skip QC steps and use input directly (useful for testing/reruns)

    // Multi-source integration settings
    // Used when samplesheet contains patient_id and seq_type columns
    source_weights          = 'WGS:1.0,WES:0.8,RNAseq:0.6,targeted:0.5'
    auto_tools_by_seqtype   = true   // Auto-select tools based on seq_type in multi-source mode

    // Resource settings
    max_cpus        = 8
    max_memory      = '32.GB'
    max_time        = '24.h'

    // Container paths (for tools that use containers)
    container_dir   = "${projectDir}/../hla_references/containers"

    // Base tools container (for samtools, bc, fastqc, python)
    // This container is used for QC and preprocessing steps
    basetools_container = "${projectDir}/../hla_references/containers/basetools.sif"

    // Post-processing container (for visualization, reporting with matplotlib/pandas)
    postprocess_container = "${projectDir}/../hla_references/containers/hla_postprocess.sif"

    // SpecHLA settings
    // Container-based execution (recommended for HPC environments like Puhti)
    use_local_spechla = false                            // Use container instead of local installation
    spechla_path    = "/opt/SpecHLA"                     // Path inside container
    local_lib_path  = null                               // Custom library path for local installs (e.g., conda lib)

    // Database paths
    hlahd_db        = "${projectDir}/../hla_references/databases/hlahd_db"
    hlala_graphs    = "${projectDir}/../hla_references/databases/hlala_graphs"

    // HLA*LA settings
    hlala_graph     = 'PRG_MHC_GRCh38_withIMGT'

    // HLAscan settings
    // Note: HLAscan v2.1 container only supports hg19 (-v 37); hg38 outputs NA.
    // The DB uses the container's built-in /db/HLA-ALL.IMGT (proprietary format).
    // To use a custom DB, set hlascan_db to a directory containing HLA-ALL.IMGT;
    // it will be bind-mounted to /db inside the container.
    hlascan_db      = null  // null = use container's built-in /db

    // Consensus settings
    min_tools       = 1          // Minimum tools required for consensus
    resolution      = '2-field'  // 2-field, 4-field
    expected_reads  = 1000       // Expected reads per allele for confidence calculation
    weighting       = 'read_confidence'  // Weighting method: equal, read_confidence, tool_quality, calibrated
    weights_file    = null       // Path to calibrated weights JSON (required when weighting=calibrated)

    // Output format settings
    // 'text'      : standard TSV consensus + comparison files (default)
    // 'gl_string' : text + GL String Consortium format file (<sample>_gl_string.txt)
    // 'hml'       : text + GL string + HML v1.0.1 XML (<sample>.hml.xml) for NMDP/transplant registries
    // 'all'       : all formats
    output_format       = 'text'
    allele_db_version   = '3.57.0'   // IMGT/HLA release version reported in HML output
    hml_center_id       = 'HLA-PIPELINE'  // Reporting centre ID embedded in HML XML

    // LOH (Loss of Heterozygosity) analysis settings
    // Requires SpecHLA output and tumor purity/ploidy estimates
    run_loh         = false      // Enable LOH analysis
    tumor_purity    = null       // Tumor purity (0-1), required for LOH
    tumor_ploidy    = null       // Tumor ploidy, required for LOH
    loh_het_cutoff  = 5          // Minimum heterozygous SNPs for LOH call

    // Help
    help            = false

    // POLYSOLVER settings
    // Container: docker.io/sachet/polysolver:v4 (public DockerHub)
    // Convert to SIF: singularity pull polysolver.sif docker://sachet/polysolver:v4
    // Note: hg19/GRCh37-aligned BAM required; hg38 BAMs will produce empty output

    // Kourami settings
    // Prerequisites: hs38NoAltDH reference + IMGT-formatted HLA DB
    // Build instructions in linnil1/HLA_collections kourami_preprocess.dockerfile
    kourami_dir      = null   // path to Kourami install dir (contains scripts/ and build/Kourami.jar)
    kourami_db       = null   // path to IMGT-formatted HLA DB (contains All_FINAL_with_Decoy.fa.gz)
    kourami_hs38_ref = null   // path to hs38NoAltDH.fa (plus .fai, .bwt, .amb, .ann, .pac, .sa)

    // seq2HLA settings
    // Container: quay.io/biocontainers/seq2hla:2.3--hdfd78af_0 (bioconda/public)
    // Note: built-in IMGT reference v2.2; no external database required
    // Recommended for --seq_type rna only
}

// Process configuration
process {
    errorStrategy = 'retry'
    maxRetries = 2

    withLabel: 'process_low' {
        cpus = 2
        memory = '4.GB'
        time = '2.h'
    }

    withLabel: 'process_medium' {
        cpus = 4
        memory = '8.GB'
        time = '4.h'
    }

    withLabel: 'process_high' {
        cpus = 8
        memory = '16.GB'
        time = '8.h'
    }

    withName: 'SPECHLA' {
        container = params.use_local_spechla ? null : "${params.container_dir}/spechla_with_spechap.sif"
        cpus = { params.max_cpus }
        memory = '16.GB'
        time = '4.h'
    }

    withName: 'HLAHD' {
        container = "${params.container_dir}/hlahd.sif"
        cpus = { params.max_cpus }
        memory = '14.GB'
        time = '4.h'
    }

    withName: 'HLALA' {
        container = "${params.container_dir}/hlala.sif"
        cpus = { params.max_cpus }
        memory = '20.GB'  // HLA*LA needs more memory
        time = '6.h'
        containerOptions = "--bind ${params.hlala_graphs}:/usr/local/bin/HLA-LA/graphs"
    }

    withName: 'ARCASHLA' {
        container = "${params.container_dir}/arcashla.sif"
        cpus = { params.max_cpus }
        memory = '8.GB'
        time = '2.h'
    }

    withName: 'OPTITYPE' {
        container = "${params.container_dir}/optitype.sif"
        cpus = 4
        memory = '8.GB'
        time = '2.h'
    }

    withName: 'XHLA' {
        container = "${params.container_dir}/xhla.sif"
        cpus = 4
        memory = '8.GB'
        time = '6.h'
    }

    withName: 'BAMQC|BAMQC_FASTQ' {
        container = "${params.container_dir}/bamqc.sif"
        cpus = 2
        memory = '4.GB'
        time = '1.h'
    }

    withName: 'CONSENSUS' {
        container = "${params.postprocess_container}"
        cpus = 1
        memory = '2.GB'
        time = '30.m'
    }

    withName: 'MULTISOURCE_CONSENSUS' {
        container = "${params.postprocess_container}"
        cpus = 1
        memory = '4.GB'
        time = '30.m'
    }

    // Preprocessing processes (use basetools container with samtools)
    withName: 'CHECK_BAM' {
        container = "${params.basetools_container}"
        cpus = 2
        memory = '4.GB'
        time = '30.m'
    }

    withName: 'EXTRACT_HLA_READS' {
        container = "${params.basetools_container}"
        cpus = 4
        memory = '8.GB'
        time = '2.h'
    }

    withName: 'EXTRACT_HLA_READS_HLAHD' {
        container = "${params.basetools_container}"
        cpus = 4
        memory = '8.GB'
        time = '2.h'
    }

    withName: 'BAM_TO_FASTQ' {
        container = "${params.basetools_container}"
        cpus = 4
        memory = '8.GB'
        time = '2.h'
    }

    withName: 'QC_BAM' {
        container = "${params.basetools_container}"
        cpus = 2
        memory = '4.GB'
        time = '1.h'
    }

    withName: 'QC_FASTQ' {
        container = "${params.basetools_container}"
        cpus = 2
        memory = '4.GB'
        time = '1.h'
    }

    withName: 'SPECHLA_FASTQ' {
        container = params.use_local_spechla ? null : "${params.container_dir}/spechla_with_spechap.sif"
        cpus = { params.max_cpus }
        memory = '16.GB'
        time = '4.h'
    }

    withName: 'HLAHD_FASTQ' {
        container = "${params.container_dir}/hlahd.sif"
        cpus = { params.max_cpus }
        memory = '16.GB'
        time = '4.h'
    }

    withName: 'ARCASHLA_FASTQ' {
        container = "${params.container_dir}/arcashla.sif"
        cpus = { params.max_cpus }
        memory = '8.GB'
        time = '2.h'
    }

    withName: 'OPTITYPE_FASTQ' {
        container = "${params.container_dir}/optitype.sif"
        cpus = 4
        memory = '8.GB'
        time = '2.h'
    }

    withName: 'XHLA_FASTQ' {
        container = "${params.container_dir}/xhla.sif"
        cpus = 4
        memory = '8.GB'
        time = '6.h'
    }

    withName: 'HLASCAN' {
        container = "${params.container_dir}/hlascan.sif"
        cpus = { params.max_cpus }
        memory = '8.GB'
        time = '4.h'
        // If params.hlascan_db is set, bind-mount it to /db inside the container.
        // Otherwise the container's built-in /db/HLA-ALL.IMGT is used.
        containerOptions = params.hlascan_db ? "--bind ${params.hlascan_db}:/db" : ''
    }

    withName: 'HLASCAN_FASTQ' {
        container = "${params.container_dir}/hlascan.sif"
        cpus = { params.max_cpus }
        memory = '8.GB'
        time = '4.h'
        containerOptions = params.hlascan_db ? "--bind ${params.hlascan_db}:/db" : ''
    }

    withName: 'T1K_FASTQ|T1K_LONGREADS' {
        container = 'quay.io/biocontainers/t1k:1.0.9--h5ca1c30_0'
        cpus = { params.max_cpus }
        memory = '8.GB'
        time = '2.h'
    }

    withName: 'HIFIHLA' {
        // PacBio's HiFi-HLA container (publicly available on Quay.io)
        container = 'quay.io/pacbio/hifihla:latest'
        cpus = { params.max_cpus }
        memory = '16.GB'   // phasing HLA loci from long reads is memory-intensive
        time = '4.h'
        errorStrategy = 'ignore'  // container may not be available on all systems
    }

    withName: 'FASTQC_BAM' {
        container = "${params.basetools_container}"
        cpus = 2
        memory = '4.GB'
        time = '1.h'
    }

    withName: 'FASTQC_FASTQ' {
        container = "${params.basetools_container}"
        cpus = 2
        memory = '4.GB'
        time = '1.h'
    }

    withName: 'HLA_VISUALIZE' {
        container = "${params.postprocess_container}"
        cpus = 1
        memory = '4.GB'
        time = '30.m'
    }

    withName: 'HLA_SUMMARY_REPORT' {
        container = "${params.postprocess_container}"
        cpus = 1
        memory = '4.GB'
        time = '30.m'
    }

    withName: 'MULTIQC' {
        container = "${params.postprocess_container}"
        cpus = 1
        memory = '4.GB'
        time = '30.m'
    }

    withName: 'HLA_LOH' {
        container = "${params.basetools_container}"
        cpus = 1
        memory = '4.GB'
        time = '30.m'
    }

    withName: 'HLA_LOH_VISUALIZE' {
        container = "${params.postprocess_container}"
        cpus = 1
        memory = '4.GB'
        time = '30.m'
    }

    withName: 'HLA_LOH_SUMMARY' {
        container = "${params.basetools_container}"
        cpus = 1
        memory = '4.GB'
        time = '30.m'
    }

    withName: 'POLYSOLVER' {
        // Container: pull from DockerHub and convert with:
        //   singularity pull polysolver.sif docker://sachet/polysolver:v4
        container = "${params.container_dir}/polysolver.sif"
        cpus      = 4
        memory    = '8.GB'
        time      = '4.h'
        // POLYSOLVER is hg19-only; BAM must be hg19-aligned coordinate-sorted
    }

    withName: 'SEQ2HLA' {
        // Public bioconda container; no SIF conversion needed if using Docker mode
        // For Singularity: singularity pull seq2hla.sif docker://quay.io/biocontainers/seq2hla:2.3--hdfd78af_0
        container = 'quay.io/biocontainers/seq2hla:2.3--hdfd78af_0'
        cpus      = 4
        memory    = '8.GB'
        time      = '2.h'
    }

    withName: 'KOURAMI' {
        // Build SIF from kourami_preprocess.dockerfile (linnil1/HLA_collections) + add openjdk-11-jdk
        container = "${params.container_dir}/kourami.sif"
        cpus      = { params.max_cpus }
        memory    = '14.GB'
        time      = '4.h'
        // Requires params.kourami_dir, params.kourami_db, params.kourami_hs38_ref
    }
}

// Profiles
profiles {
    standard {
        process.executor = 'local'
    }

    // Local profile: assumes all tools are installed locally (no containers)
    local {
        process.executor = 'local'
        // Disable all containers for local execution
        process {
            withName: '.*' {
                container = null
            }
        }
    }

    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.runOptions = '--writable-tmpfs --cleanenv'
        // Bind common paths
        singularity.cacheDir = "${params.container_dir ?: './containers'}"
    }

    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    slurm {
        process.executor = 'slurm'
        process.queue = 'normal'
        process.clusterOptions = '--account=your_account'
    }

    test {
        params.max_cpus = 2
        params.max_memory = '6.GB'
        params.max_time = '1.h'
    }
}

// Manifest
manifest {
    name            = 'hla-typing-pipeline'
    author          = 'HLA Analysis Team'
    homePage        = 'https://github.com/your-org/hla-typing-pipeline'
    description     = 'Multi-tool HLA typing consensus pipeline with calibrated weighted voting, GL String/HML clinical output, long-read support, and population-stratified benchmarking'
    mainScript      = 'main.nf'
    nextflowVersion = '>=22.10.0'
    version         = '1.4.0'
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Timeline, report, trace
def timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline_${timestamp}.html"
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report_${timestamp}.html"
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace_${timestamp}.txt"
}
