// Skip QC processes and run only HLA typing + consensus
params {
    container_dir = "/home/umut/projects/project_2008084/ozcanumu/hla_rnaseq_analysis/hla_references/containers"

    // HLA-HD: use database bundled inside the container at /app/hlahd.1.4.0
    hlahd_db      = "/app/hlahd.1.4.0"

    // SpecHLA: use local installation (avoids container Python env issues)
    use_local_spechla = true
    spechla_path      = "/home/umut/SpecHLA"

    // HLA*LA: bind-mount the local graph into the container
    hlala_graphs  = "/home/umut/projects/project_2008084/ozcanumu/hla_rnaseq_analysis/hla_references/databases/hlala_graphs"

    // Kourami: local install (v0.9.6); DB downloaded via download_panel.sh
    kourami_dir      = "/home/umut/projects/project_2008084/kourami/kourami-0.9.6"
    kourami_db       = "/home/umut/projects/project_2008084/kourami/kourami-0.9.6/db"
    kourami_hs38_ref = null   // null = use samtools direct HLA-region extraction
}

process {
    // QC runs on host; ignore failures
    // shell: remove pipefail to prevent SIGPIPE from 'zcat | awk | head -N' pipelines
    withName: 'QC_BAM|FASTQC_BAM|QC_FASTQ|FASTQC_FASTQ' {
        container     = null
        errorStrategy = 'ignore'
        shell         = ['/bin/bash', '-e']
    }

    // Disable containers for postprocessing (use local python)
    withName: 'CONSENSUS|HLA_VISUALIZE|HLA_SUMMARY_REPORT|HLA_LOH|HLA_LOH_VISUALIZE|HLA_LOH_SUMMARY' {
        container = null
    }

    // MULTIQC not installed on host — ignore failures
    withName: 'MULTIQC' {
        container     = null
        errorStrategy = 'ignore'
    }

    // arcasHLA: explicit container path
    withName: 'ARCASHLA|ARCASHLA_FASTQ' {
        container     = "/home/umut/projects/project_2008084/ozcanumu/hla_rnaseq_analysis/hla_references/containers/arcashla.sif"
        errorStrategy = 'ignore'
        shell         = ['/bin/bash', '-e']
    }

    // OptiType: explicit container path; ignore failures (container issues on WSL2)
    withName: 'OPTITYPE|OPTITYPE_FASTQ' {
        container     = "/home/umut/projects/project_2008084/ozcanumu/hla_rnaseq_analysis/hla_references/containers/optitype.sif"
        errorStrategy = 'ignore'
        shell         = ['/bin/bash', '-e']
    }

    // SpecHLA: run via local installation (params.use_local_spechla = true); no container needed
    withName: 'SPECHLA|SPECHLA_FASTQ' {
        container     = null
        memory        = '14.GB'
        errorStrategy = 'ignore'
        shell         = ['/bin/bash', '-e']
    }

    // HLA-HD: bind samtools wrapper + conda arcas-hla env (samtools 1.19.2 + libhts)
    withName: 'HLAHD|HLAHD_FASTQ' {
        container        = "/home/umut/projects/project_2008084/ozcanumu/hla_rnaseq_analysis/hla_references/containers/hlahd.sif"
        memory           = '12.GB'
        errorStrategy    = 'ignore'
        shell            = ['/bin/bash', '-e']
        containerOptions = "--bind /mnt/d/samtools_compat/samtools_wrapper.sh:/usr/bin/samtools --bind /home/umut/miniconda3/envs/arcas-hla:/mnt/arcas_env"
    }

    // xHLA: bind samtools wrapper over old v1.3 + conda arcas-hla env (adds -@ thread support)
    withName: 'XHLA|XHLA_FASTQ' {
        container        = "/home/umut/projects/project_2008084/ozcanumu/hla_rnaseq_analysis/hla_references/containers/xhla.sif"
        errorStrategy    = 'ignore'
        shell            = ['/bin/bash', '-e']
        containerOptions = "--bind /mnt/d/samtools_compat/samtools_wrapper.sh:/usr/local/bin/samtools --bind /home/umut/miniconda3/envs/arcas-hla:/mnt/arcas_env"
    }

    // HLAscan: use built-in /db (HLA-ALL.IMGT format); no external DB bind needed
    // Note: v2.1 only supports hg19; hg38 produces NA output automatically
    withName: 'HLASCAN|HLASCAN_FASTQ' {
        container        = "/home/umut/projects/project_2008084/ozcanumu/hla_rnaseq_analysis/hla_references/containers/hlascan.sif"
        errorStrategy    = 'ignore'
        containerOptions = ''  // use built-in /db inside container
    }

    // T1K: biocontainers image; covers Class I + II; fast (~5 min), low memory (~4 GB)
    // SIF built with: singularity pull docker://quay.io/biocontainers/t1k:1.0.9--h5ca1c30_0
    withName: 'T1K_FASTQ' {
        container     = "/home/umut/projects/project_2008084/ozcanumu/hla_rnaseq_analysis/hla_references/containers/t1k.sif"
        memory        = '8.GB'
        cpus          = 4
        errorStrategy = 'ignore'
    }

    // HLA*LA: explicit container path + graph bind-mount
    // memory reduced to 14 GB (system has ~15.5 GB total; nextflow.config default is 20 GB)
    withName: 'HLALA' {
        container        = "/home/umut/projects/project_2008084/ozcanumu/hla_rnaseq_analysis/hla_references/containers/hlala.sif"
        memory           = '14.GB'
        errorStrategy    = 'ignore'
        containerOptions = "--bind /home/umut/projects/project_2008084/ozcanumu/hla_rnaseq_analysis/hla_references/databases/hlala_graphs:/usr/local/bin/HLA-LA/graphs"
    }

    // POLYSOLVER: polysolver.sif (pulled from docker://sachet/polysolver:v4)
    // SAMTOOLS_DIR fix: hg38 branch uses $SAMTOOLS_DIR which is unset in container → injected below
    // NOTE: novoalign binary (v2.07.18, 2012) crashes with SIGSEGV on WSL2; works on native Linux/HPC
    withName: 'POLYSOLVER' {
        container        = "/home/umut/projects/project_2008084/ozcanumu/hla_rnaseq_analysis/hla_references/containers/polysolver.sif"
        memory           = '8.GB'
        errorStrategy    = 'ignore'
        shell            = ['/bin/bash', '-e']
        containerOptions = ""  // add --env SINGULARITYENV_SAMTOOLS_DIR=/home/polysolver/binaries if Singularity ≥ 3.6
    }

    // seq2HLA: pull directly from bioconda via Singularity or use local SIF
    // Pull SIF: singularity pull seq2hla.sif docker://quay.io/biocontainers/seq2hla:2.3--hdfd78af_0
    withName: 'SEQ2HLA' {
        container     = "/home/umut/projects/project_2008084/ozcanumu/hla_rnaseq_analysis/hla_references/containers/seq2hla.sif"
        memory        = '8.GB'
        errorStrategy = 'ignore'
        shell         = ['/bin/bash', '-e']
    }

    // Kourami: zlskidmore/kourami container (Ubuntu 18.04, BWA + Java 10 + bundled DB)
    // samtools NOT in container → bind-mount samtools wrapper (same pattern as HLAHD/xHLA)
    withName: 'KOURAMI' {
        container        = "/home/umut/projects/project_2008084/ozcanumu/hla_rnaseq_analysis/hla_references/containers/kourami.sif"
        containerOptions = "--bind /mnt/d/samtools_compat/samtools_wrapper.sh:/usr/local/bin/samtools --bind /home/umut/miniconda3/envs/arcas-hla:/mnt/arcas_env"
        memory           = '12.GB'
        errorStrategy    = 'ignore'
        shell            = ['/bin/bash', '-e']
    }
}

singularity.enabled = true
