# Nextflow work directory
work/
.nextflow/
.nextflow.log*

# Results (optional - remove if you want to track results)
results/

# Container files
*.sif
*.img

# IDE
.idea/
.vscode/
*.swp
*.swo

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
dist/
build/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Temp files
*.tmp
tmp/
temp/

# Data files (too large for git)
*.bam
*.bam.bai
*.fastq
*.fastq.gz
*.fq
*.fq.gz
*.fa
*.fasta
*.fa.gz

# Databases (too large)
hla_references/databases/

# Allow config data files in conf/ (overrides parent .gitignore *.txt rule)
!conf/*.txt
!conf/*.tsv
!conf/*.json
