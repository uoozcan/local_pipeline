/*
 * Local reduced-E2E debug overlay.
 *
 * Usage:
 *   nextflow run main.nf \
 *     -c conf/user.config \
 *     -c run.config \
 *     -c conf/local_debug_e2e.config \
 *     -profile singularity \
 *     --input_bam /path/to/hla_region.bam
 *
 * Purpose:
 *   Reproduce the Puhti-failing BAM tool path locally with only the problematic
 *   tools enabled: HLA-HD, SpecHLA, arcasHLA, and OptiType.
 *
 * Notes:
 *   - This is diagnosis-only and intentionally excludes PolySolver.
 *   - It preserves local machine-specific paths from conf/user.config.
 *   - It keeps WGS-like BAM semantics: seq_type=dna, reference=hg38, skip_qc=true.
 */

params {
    tools       = 'hlahd,spechla,arcashla,optitype'
    seq_type    = 'dna'
    reference   = 'hg38'
    skip_qc     = true
    min_tools   = 1
    max_cpus    = 4
    max_memory  = '16.GB'
    max_time    = '8.h'
}
