/*
 * Puhti-specific configuration for HLA Typing Pipeline
 * CSC - IT Center for Science, Finland
 *
 * Usage:
 *   nextflow run main.nf -c conf/puhti.config -profile singularity \
 *       --project project_XXXXXXX --input_bam /path/to/sample.bam
 *
 * Before first run, execute the installation script:
 *   bash scripts/install_puhti.sh project_XXXXXXX
 */

params {
    // CSC Project (REQUIRED) - set via --project or CSC_PROJECT env variable
    project = null

    // Installation directory (auto-set based on project)
    install_dir = {
        def proj = params.project ?: System.getenv('CSC_PROJECT')
        proj ? "/projappl/${proj}/hla_typing_pipeline" : null
    }()

    // Container directory
    container_dir = params.install_dir ? "${params.install_dir}/containers" : null

    // SpecHLA path inside container (compiled with SpecHap)
    spechla_path = "/opt/SpecHLA"

    // Use containerized SpecHLA (recommended for HPC)
    use_local_spechla = false
    local_lib_path = null
    spechla_sif   = null    // override path to spechla SIF (default: container_dir/spechla_with_spechap.sif)

    // Post-processing container path
    postprocess_container = params.container_dir ? "${params.container_dir}/hla_postprocess.sif" : null

    // Output directory (scratch recommended for large outputs)
    outdir = {
        def proj = params.project ?: System.getenv('CSC_PROJECT')
        proj ? "/scratch/${proj}/hla_results" : './results'
    }()

    // Puhti-optimized resource settings
    max_cpus   = 40
    max_memory = '180.GB'
    max_time   = '72.h'

    // Default tools for Puhti (containers available)
    // For calibration use: hlahd,spechla,arcashla,optitype
    tools = 'hlahd,spechla,arcashla,optitype'

    // Reference genome
    reference = 'hg38'

    // Sequence type (dna or rna)
    seq_type = 'dna'
}

// Singularity settings for Puhti
singularity {
    enabled = true
    autoMounts = true
    runOptions = '--bind /scratch:/scratch --bind /projappl:/projappl --bind /users:/users --bind /appl:/appl --cleanenv --writable-tmpfs'
    cacheDir = "${params.install_dir}/singularity_cache"
}

// Executor settings
executor {
    name = 'slurm'
    queueSize = 50
    submitRateLimit = '10 sec'
    exitReadTimeout = '5 min'
}

// Process settings optimized for Puhti partitions
process {
    executor = 'slurm'
    queue = { task.memory <= 180.GB ? 'small' : 'bigmem' }

    // Default cluster options - reads from params.project, CSC_PROJECT env var, or SLURM_JOB_ACCOUNT
    clusterOptions = { "--account=${params.project ?: System.getenv('CSC_PROJECT') ?: System.getenv('SLURM_JOB_ACCOUNT')}" }

    // Error handling
    errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
    maxRetries = 2

    // Default container (arcashla has most tools)
    container = "${params.container_dir}/arcashla.sif"

    // Default resources
    cpus = 4
    memory = '16.GB'
    time = '4.h'

    // Resource labels
    withLabel: 'process_low' {
        cpus = 2
        memory = '8.GB'
        time = '2.h'
    }

    withLabel: 'process_medium' {
        cpus = 8
        memory = '32.GB'
        time = '4.h'
    }

    withLabel: 'process_high' {
        cpus = 20
        memory = '64.GB'
        time = '8.h'
    }

    // HLA typing tools - resource intensive
    withName: 'SPECHLA|SPECHLA_FASTQ' {
        container = params.spechla_sif ?: "${params.container_dir}/spechla_with_spechap.sif"
        cpus = 20
        memory = { 64.GB * task.attempt }
        time = { 8.h * task.attempt }
        errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
    }

    withName: 'HLAHD|HLAHD_FASTQ' {
        container = "${params.container_dir}/hlahd.sif"
        cpus = 20
        memory = { 64.GB * task.attempt }
        time = { 8.h * task.attempt }
        errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
    }

    withName: 'HLALA' {
        container = "${params.container_dir}/hlala.sif"
        cpus = 20
        memory = { 80.GB * task.attempt }
        time = { 12.h * task.attempt }
        queue = { task.attempt > 1 ? 'bigmem' : 'small' }
    }

    withName: 'ARCASHLA|ARCASHLA_FASTQ' {
        container = "${params.container_dir}/arcashla.sif"
        cpus = 10
        memory = '32.GB'
        time = '4.h'
    }

    withName: 'OPTITYPE|OPTITYPE_FASTQ' {
        container = "${params.container_dir}/optitype.sif"
        cpus = 8
        memory = '32.GB'
        time = '4.h'
    }

    withName: 'XHLA|XHLA_FASTQ' {
        container = "${params.container_dir}/xhla.sif"
        cpus = 8
        memory = '32.GB'
        time = '6.h'
        // Note: xHLA align.pl takes ~2h; typing.r uses bash SIGKILL after 30min
        containerOptions = "--bind /scratch:/scratch --bind /projappl:/projappl --bind /users:/users --bind /appl:/appl --cleanenv --writable-tmpfs"
        errorStrategy = 'ignore'
    }

    withName: 'T1K_FASTQ|T1K_LONGREADS' {
        container = "${params.container_dir}/t1k.sif"
        cpus = { params.max_cpus }
        memory = '8.GB'
        time = '2.h'
    }

    withName: 'HIFIHLA' {
        container = "${params.container_dir}/hifihla.sif"
        cpus = { params.max_cpus }
        memory = '16.GB'
        time = '4.h'
        errorStrategy = 'ignore'
    }

    // QC processes - lighter resources
    withName: 'QC_BAM|QC_FASTQ' {
        container = "${params.container_dir}/arcashla.sif"
        cpus = 4
        memory = '16.GB'
        time = '2.h'
        errorStrategy = 'ignore'  // SIGPIPE (exit 141) from zcat|head pipe is non-critical
    }

    withName: 'FASTQC_BAM|FASTQC_FASTQ' {
        container = "${params.container_dir}/fastqc.sif"
        cpus = 4
        memory = '16.GB'
        time = '2.h'
        errorStrategy = 'ignore'
    }

    // Post-processing - uses visualization container with matplotlib/pandas
    withName: 'CONSENSUS' {
        container = "${params.container_dir}/hla_postprocess.sif"
        cpus = 2
        memory = '4.GB'
        time = '30.m'
    }

    withName: 'HLA_VISUALIZE' {
        container = "${params.container_dir}/hla_postprocess.sif"
        cpus = 2
        memory = '8.GB'
        time = '1.h'
    }

    withName: 'HLA_SUMMARY_REPORT' {
        container = "${params.container_dir}/hla_postprocess.sif"
        cpus = 2
        memory = '8.GB'
        time = '1.h'
    }

    withName: 'MULTIQC' {
        container = "${params.container_dir}/hla_postprocess.sif"
        cpus = 2
        memory = '8.GB'
        time = '1.h'
    }
}

// Puhti partition reference:
// small:  max 40 cores, 180 GB memory, 3 days
// bigmem: max 1.5 TB memory, 14 days
// Note: Billing units = cores * max(memory/1.875, cores) * time_hours
