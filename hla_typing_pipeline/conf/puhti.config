/*
 * Puhti-specific configuration for HLA Typing Pipeline
 * CSC - IT Center for Science, Finland
 *
 * Usage: nextflow run main.nf -c conf/puhti.config -profile singularity
 */

params {
    // Puhti-optimized resource settings
    max_cpus   = 40
    max_memory = '180.GB'
    max_time   = '72.h'

    // Default tools for Puhti (containers available)
    tools = 'spechla,hlahd'
}

// Singularity settings for Puhti
singularity {
    enabled = true
    autoMounts = true
    runOptions = '--bind /scratch,/projappl,/users --bind /appl'
}

// Executor settings
executor {
    name = 'slurm'
    queueSize = 50
    submitRateLimit = '10 sec'
    exitReadTimeout = '5 min'
}

// Process settings optimized for Puhti partitions
process {
    executor = 'slurm'
    queue = { task.memory <= 180.GB ? 'small' : 'bigmem' }

    // Default cluster options
    clusterOptions = { "--account=${params.project ?: System.getenv('CSC_PROJECT') ?: 'project_2008084'}" }

    // Error handling
    errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
    maxRetries = 2

    // Default resources
    cpus = 4
    memory = '16.GB'
    time = '4.h'

    // Resource labels
    withLabel: 'process_low' {
        cpus = 2
        memory = '8.GB'
        time = '2.h'
    }

    withLabel: 'process_medium' {
        cpus = 8
        memory = '32.GB'
        time = '4.h'
    }

    withLabel: 'process_high' {
        cpus = 20
        memory = '64.GB'
        time = '8.h'
    }

    // HLA typing tools - resource intensive
    withName: 'SPECHLA|SPECHLA_FASTQ' {
        cpus = 20
        memory = { 64.GB * task.attempt }
        time = { 8.h * task.attempt }
        errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
    }

    withName: 'HLAHD|HLAHD_FASTQ' {
        cpus = 20
        memory = { 64.GB * task.attempt }
        time = { 8.h * task.attempt }
        errorStrategy = { task.exitStatus in [143,137,104,134,139,140] ? 'retry' : 'finish' }
    }

    withName: 'HLALA' {
        cpus = 20
        memory = { 80.GB * task.attempt }
        time = { 12.h * task.attempt }
        queue = { task.attempt > 1 ? 'bigmem' : 'small' }
    }

    withName: 'ARCASHLA|ARCASHLA_FASTQ' {
        cpus = 10
        memory = '32.GB'
        time = '4.h'
    }

    withName: 'OPTITYPE|OPTITYPE_FASTQ' {
        cpus = 8
        memory = '32.GB'
        time = '4.h'
    }

    // QC processes - lighter resources
    withName: 'QC_BAM|QC_FASTQ' {
        cpus = 4
        memory = '16.GB'
        time = '2.h'
    }

    withName: 'FASTQC_BAM|FASTQC_FASTQ' {
        cpus = 4
        memory = '16.GB'
        time = '2.h'
    }

    // Post-processing - minimal resources
    withName: 'CONSENSUS' {
        cpus = 2
        memory = '4.GB'
        time = '30.m'
    }

    withName: 'HLA_VISUALIZE' {
        cpus = 2
        memory = '8.GB'
        time = '1.h'
    }

    withName: 'HLA_SUMMARY_REPORT' {
        cpus = 2
        memory = '8.GB'
        time = '1.h'
    }

    withName: 'MULTIQC' {
        cpus = 2
        memory = '8.GB'
        time = '1.h'
    }
}

// Puhti partition reference:
// small:  max 40 cores, 180 GB memory, 3 days
// bigmem: max 1.5 TB memory, 14 days
// Note: Billing units = cores * max(memory/1.875, cores) * time_hours
