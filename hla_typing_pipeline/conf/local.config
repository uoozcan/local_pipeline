/*
 * Local execution configuration (no containers)
 * Use this when running SpecHLA from a local installation
 *
 * Prerequisites:
 *   - SpecHLA installed locally with SpecHap compiled
 *   - All dependencies (samtools, bcftools, bowtie2, bwa, etc.) in PATH
 *   - Python with pysam, pandas, numpy, matplotlib, etc.
 *
 * Usage:
 *   nextflow run main.nf -c conf/local.config -profile local \
 *       --input_bam /path/to/sample.bam
 */

params {
    // SpecHLA local installation settings
    use_local_spechla = true
    spechla_path = "/path/to/SpecHLA"      // Update to your SpecHLA installation

    // Optional: Custom library path for htslib compatibility
    // Set this if SpecHap was compiled with a different htslib version
    // Example: "/home/user/miniconda3/lib" or "/usr/local/lib"
    local_lib_path = null

    // Tool selection (local typically only supports spechla)
    tools = 'spechla'

    // Output directory
    outdir = './results'

    // Reference genome
    reference = 'hg38'

    // Resource limits for local execution
    max_cpus   = 8
    max_memory = '32.GB'
    max_time   = '24.h'
}

// Disable all containers
singularity.enabled = false
docker.enabled = false

// Local executor
process {
    executor = 'local'

    // Disable containers for all processes
    container = null

    withLabel: 'process_low' {
        cpus = 2
        memory = '4.GB'
    }

    withLabel: 'process_medium' {
        cpus = 4
        memory = '8.GB'
    }

    withLabel: 'process_high' {
        cpus = 8
        memory = '16.GB'
    }
}
