Bootstrap: docker
From: ubuntu:20.04

%labels
    Author HLA Typing Pipeline
    Version 1.0.7
    Description SpecHLA container with SpecHap and ExtractHAIRs compiled

%post
    # Prevent interactive prompts
    export DEBIAN_FRONTEND=noninteractive
    export TZ=UTC

    # Update and install dependencies
    apt-get update && apt-get install -y \
        wget \
        curl \
        git \
        build-essential \
        cmake \
        zlib1g-dev \
        libbz2-dev \
        liblzma-dev \
        libcurl4-openssl-dev \
        libssl-dev \
        libncurses5-dev \
        libncursesw5-dev \
        libarpack2-dev \
        liblapack-dev \
        libblas-dev \
        gfortran \
        python3 \
        python3-pip \
        python3-dev \
        autoconf \
        automake \
        pkg-config \
        bc \
        gzip \
        pigz \
        unzip \
        && rm -rf /var/lib/apt/lists/*

    # Install htslib (latest version for SpecHap compatibility)
    cd /tmp
    wget https://github.com/samtools/htslib/releases/download/1.19/htslib-1.19.tar.bz2
    tar -xjf htslib-1.19.tar.bz2
    cd htslib-1.19
    ./configure --prefix=/usr/local
    make -j$(nproc)
    make install
    ldconfig
    cd /tmp && rm -rf htslib-1.19*

    # Install samtools
    cd /tmp
    wget https://github.com/samtools/samtools/releases/download/1.19/samtools-1.19.tar.bz2
    tar -xjf samtools-1.19.tar.bz2
    cd samtools-1.19
    ./configure --prefix=/usr/local
    make -j$(nproc)
    make install
    cd /tmp && rm -rf samtools-1.19*

    # Install bcftools
    cd /tmp
    wget https://github.com/samtools/bcftools/releases/download/1.19/bcftools-1.19.tar.bz2
    tar -xjf bcftools-1.19.tar.bz2
    cd bcftools-1.19
    ./configure --prefix=/usr/local
    make -j$(nproc)
    make install
    cd /tmp && rm -rf bcftools-1.19*

    # Install BWA
    cd /tmp
    git clone https://github.com/lh3/bwa.git
    cd bwa
    make -j$(nproc)
    cp bwa /usr/local/bin/
    cd /tmp && rm -rf bwa

    # Install bowtie2
    cd /tmp
    wget https://github.com/BenLangmead/bowtie2/releases/download/v2.5.1/bowtie2-2.5.1-linux-x86_64.zip
    unzip bowtie2-2.5.1-linux-x86_64.zip
    cp bowtie2-2.5.1-linux-x86_64/bowtie2* /usr/local/bin/
    rm -rf bowtie2-2.5.1*

    # Install BLAST+
    cd /tmp
    wget https://ftp.ncbi.nlm.nih.gov/blast/executables/blast+/2.14.0/ncbi-blast-2.14.0+-x64-linux.tar.gz
    tar -xzf ncbi-blast-2.14.0+-x64-linux.tar.gz
    cp ncbi-blast-2.14.0+/bin/* /usr/local/bin/
    rm -rf ncbi-blast-2.14.0+*

    # Install freebayes
    cd /tmp
    wget https://github.com/freebayes/freebayes/releases/download/v1.3.6/freebayes-1.3.6-linux-amd64-static.gz
    gunzip freebayes-1.3.6-linux-amd64-static.gz
    chmod +x freebayes-1.3.6-linux-amd64-static
    mv freebayes-1.3.6-linux-amd64-static /usr/local/bin/freebayes

    # Install bedtools
    cd /tmp
    wget https://github.com/arq5x/bedtools2/releases/download/v2.31.0/bedtools.static
    chmod +x bedtools.static
    mv bedtools.static /usr/local/bin/bedtools

    # Install Python packages
    pip3 install --no-cache-dir \
        numpy \
        scipy \
        pandas \
        biopython \
        pysam \
        networkx

    # Clone and install SpecHLA
    cd /opt
    git clone https://github.com/deepomicslab/SpecHLA.git
    cd SpecHLA

    # Build SpecHap
    mkdir -p bin/SpecHap/build
    cd bin/SpecHap/build
    cmake .. -DCMAKE_PREFIX_PATH=/usr/local
    make -j$(nproc)
    cd /opt/SpecHLA

    # Build ExtractHAIRs
    mkdir -p bin/extractHairs/build
    cd bin/extractHairs/build
    cmake .. -DCMAKE_PREFIX_PATH=/usr/local -DCMAKE_POLICY_VERSION_MINIMUM=3.5
    make -j$(nproc)
    cd /opt/SpecHLA

    # Build bowtie2 index for SpecHLA database
    cd /opt/SpecHLA
    if [ -f db/ref/hla_gen.format.filter.extend.DRB.no26789.fasta ] && [ ! -f db/ref/hla_gen.format.filter.extend.DRB.no26789.fasta.1.bt2 ]; then
        bowtie2-build db/ref/hla_gen.format.filter.extend.DRB.no26789.fasta db/ref/hla_gen.format.filter.extend.DRB.no26789.fasta
    fi
    if [ -f db/ref/hla_gen.format.filter.extend.DRB.no26789.v2.fasta ] && [ ! -f db/ref/hla_gen.format.filter.extend.DRB.no26789.v2.fasta.1.bt2 ]; then
        bowtie2-build db/ref/hla_gen.format.filter.extend.DRB.no26789.v2.fasta db/ref/hla_gen.format.filter.extend.DRB.no26789.v2.fasta
    fi

    # Create symlinks for library compatibility
    ln -sf /usr/local/lib/libhts.so.3 /opt/SpecHLA/spechla_env/lib/libhts.so.3 2>/dev/null || true

    # Set correct permissions
    chmod -R 755 /opt/SpecHLA

    # Clean up
    apt-get clean
    rm -rf /tmp/*

%environment
    export PATH=/opt/SpecHLA/spechla_env/bin:/opt/SpecHLA/bin:/usr/local/bin:$PATH
    export LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH
    export SPECHLA_PATH=/opt/SpecHLA

%runscript
    exec bash /opt/SpecHLA/script/whole/SpecHLA.sh "$@"

%test
    # Verify installations
    echo "Testing SpecHLA container..."
    which samtools && samtools --version | head -1
    which bowtie2 && bowtie2 --version | head -1
    which bwa && bwa 2>&1 | head -3
    which python3 && python3 --version
    python3 -c "import pysam; print('pysam:', pysam.__version__)"
    ls -la /opt/SpecHLA/bin/SpecHap/build/SpecHap
    ls -la /opt/SpecHLA/bin/extractHairs/build/ExtractHAIRs
    echo "Container test passed!"

%help
    SpecHLA container with SpecHap and ExtractHAIRs compiled.

    This container includes:
    - SpecHLA 1.0.7 with all dependencies
    - SpecHap (compiled from source)
    - ExtractHAIRs (compiled from source)
    - samtools, bcftools, bwa, bowtie2
    - BLAST+, freebayes, bedtools
    - Python 3 with pysam, numpy, scipy, pandas

    Usage:
        singularity run spechla_with_spechap.sif -n sample -1 R1.fq.gz -2 R2.fq.gz -o output

        Or use exec for specific commands:
        singularity exec spechla_with_spechap.sif samtools view input.bam

    Build:
        sudo singularity build spechla_with_spechap.sif spechla_with_spechap.def

        Or without root (requires fakeroot):
        singularity build --fakeroot spechla_with_spechap.sif spechla_with_spechap.def
