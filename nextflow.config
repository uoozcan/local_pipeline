/*
========================================================================================
    HLA TYPING PIPELINE - NEXTFLOW CONFIGURATION
========================================================================================
    Configuration file for the HLA typing pipeline
    Optimized for CSC Puhti HPC environment
========================================================================================
*/

// Global default params
params {
    enable_conda            = false
    // Input/Output
    input                   = null
    input_type              = 'fastq'
    outdir                  = './results'
    
    // Tools to run
    tools                   = 'optitype,arcashla'
    
    // Reference genome
    reference_build         = 'hg38'
    
    // Tool-specific parameters
    optitype_seq_type       = 'dna'
    arcashla_genes          = 'A,B,C,DQA1,DQB1,DRB1'
    spechla_genes           = 'A,B,C,DQA1,DQB1,DRB1'
    spechla_exon_only       = 0  // Set to 1 for exome data!

    // SpecHLA local installation (no container) - for HPC systems
    spechla_home            = '/home/umut/projects/project_2008084/ozcanumu/hla_rnaseq_analysis/spechla_local'
    spechla_use_local       = false  // Set to true to use local installation instead of container
    spechla_script          = null   // Optional: direct path to SpecHLA.sh

    // Additional tool parameters
    seq_type                = 'dna'
    hla_genes               = 'A,B,C,DQA1,DQB1,DRB1'
    reference_genome        = 'hg38'
    
    // HLA region extraction
    extract_hla_region      = false
    hla_region_start        = 28000000
    hla_region_end          = 34000000
    
    // Majority voting
    enable_majority_voting  = false
    mv_min_tools            = 2
    mv_resolution           = 2
    mv_genes                = 'A,B,C,DQA1,DQB1,DRB1'
    
    // Resource limits
    max_cpus                = 40
    max_memory              = '180.GB'
    max_time                = '24.h'
    
    // SLURM settings
    slurm_account           = null
    slurm_partition         = 'small'
    
    // Other options
    save_intermediate       = false
    help                    = false
    
    // Container cache
    singularity_cache_dir   = '/home/umut/projects/project_2008084/ozcanumu/hla_rnaseq_analysis/hla_references/containers'
}

// Process labels
process {
    // Default resources
    cpus   = 4
    memory = 16.GB
    time   = 4.h
    
    errorStrategy = { task.attempt <= 2 ? 'retry' : 'ignore' }
    maxRetries = 2
    
    // Resource labels
    withLabel: process_low {
        cpus   = 2
        memory = 8.GB
        time   = 2.h
    }
    
    withLabel: process_medium {
        cpus   = { check_max( 8 * task.attempt, 'cpus' ) }
        memory = { check_max( 32.GB * task.attempt, 'memory' ) }
        time   = { check_max( 8.h * task.attempt, 'time' ) }
    }
    
    withLabel: process_high {
        cpus   = { check_max( 16 * task.attempt, 'cpus' ) }
        memory = { check_max( 64.GB * task.attempt, 'memory' ) }
        time   = { check_max( 16.h * task.attempt, 'time' ) }
    }
    
    withLabel: low_resources {
        cpus   = 1
        memory = 4.GB
        time   = 1.h
    }
}

// Execution profiles
profiles {
    // Standard profile - Docker
    standard {
        docker.enabled = true
        docker.userEmulation = true
        
        process {
            withName: OPTITYPE {
                container = 'fred2/optitype:latest'
            }
            withName: ARCASHLA_BAM {
                container = 'nmdpbioinformatics/arcas-hla:latest'
            }
            withName: ARCASHLA_FASTQ {
                container = 'nmdpbioinformatics/arcas-hla:latest'
            }
            withName: SPECHLA_BAM {
                container = 'ghcr.io/yourusername/spechla:latest'
            }
            withName: SPECHLA_FASTQ {
                container = 'ghcr.io/yourusername/spechla:latest'
            }
        }
    }
    
    // Docker profile
    docker {
        docker.enabled = true
        docker.userEmulation = true
        singularity.enabled = false
        conda.enabled = false
    }
    
    // Singularity profile - Use pre-downloaded SIF files on CSC Puhti
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = params.singularity_cache_dir
        docker.enabled = false
        conda.enabled = false
        
        process {
            // Use pre-downloaded SIF files from CSC Puhti
            withName: OPTITYPE {
                container = "${params.singularity_cache_dir}/optitype.sif"
            }
            withName: ARCASHLA_BAM {
                container = "${params.singularity_cache_dir}/arcashla.sif"
            }
            withName: ARCASHLA_FASTQ {
                container = "${params.singularity_cache_dir}/arcashla.sif"
            }
            withName: SPECHLA_BAM {
                container = "${params.singularity_cache_dir}/spechla_1.0.7-samtools-fix.sif"
            }
            withName: SPECHLA_FASTQ {
                container = "${params.singularity_cache_dir}/spechla_1.0.7-samtools-fix.sif"
            }
        }
    }
    
    // CSC Puhti profile - Optimized for CSC Puhti HPC
    puhti {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = params.singularity_cache_dir
        
        process {
            executor = 'slurm'
            queue = params.slurm_partition
            clusterOptions = params.slurm_account ? "--account=${params.slurm_account}" : null
            
            // Use pre-downloaded SIF files
            withName: OPTITYPE {
                container = "${params.singularity_cache_dir}/optitype.sif"
            }
            withName: ARCASHLA_BAM {
                container = "${params.singularity_cache_dir}/arcashla.sif"
            }
            withName: ARCASHLA_FASTQ {
                container = "${params.singularity_cache_dir}/arcashla.sif"
            }
            withName: SPECHLA_BAM {
                container = "${params.singularity_cache_dir}/spechla_1.0.7-samtools-fix.sif"
            }
            withName: SPECHLA_FASTQ {
                container = "${params.singularity_cache_dir}/spechla_1.0.7-samtools-fix.sif"
            }
        }
    }
    
    // SLURM profile
    slurm {
        process {
            executor = 'slurm'
            queue = params.slurm_partition
            clusterOptions = params.slurm_account ? "--account=${params.slurm_account}" : null
        }
    }
    
    // Test profile
    test {
        params {
    enable_conda            = false
            max_cpus   = 2
            max_memory = '6.GB'
            max_time   = '1.h'
        }
    }

    // Local SpecHLA profile - Use local installation without containers
    // This is for HPC systems where containers are not available/preferred
    local_spechla {
        params {
            spechla_use_local = true
        }
        process {
            withName: SPECHLA_BAM {
                container = null
            }
            withName: SPECHLA_FASTQ {
                container = null
            }
        }
    }

    // Puhti with local SpecHLA - For CSC Puhti HPC with local SpecHLA
    puhti_local {
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = params.singularity_cache_dir

        params {
            spechla_use_local = true
        }

        process {
            executor = 'slurm'
            queue = params.slurm_partition
            clusterOptions = params.slurm_account ? "--account=${params.slurm_account}" : null

            // Use containers for other tools
            withName: OPTITYPE {
                container = "${params.singularity_cache_dir}/optitype.sif"
            }
            withName: ARCASHLA_BAM {
                container = "${params.singularity_cache_dir}/arcashla.sif"
            }
            withName: ARCASHLA_FASTQ {
                container = "${params.singularity_cache_dir}/arcashla.sif"
            }
            // No container for SpecHLA - use local installation
            withName: SPECHLA_BAM {
                container = null
            }
            withName: SPECHLA_FASTQ {
                container = null
            }
        }
    }
}

// Report options
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}

report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}

trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace.txt"
    fields    = 'task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,cpus,memory,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar'
}

dag {
    enabled = true
    overwrite = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.html"
}

// Manifest
manifest {
    name            = 'hla-typing-pipeline'
    author          = 'Umut'
    homePage        = 'https://github.com/yourusername/hla-typing-pipeline'
    description     = 'Comprehensive multi-tool HLA typing pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '2.0.0'
}

// Function to check maximum resource limits
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) {
            println "ERROR: Invalid max memory '${params.max_memory}'"
            return obj
        }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) {
            println "ERROR: Invalid max time '${params.max_time}'"
            return obj
        }
    } else if (type == 'cpus') {
        try {
            return Math.min(obj, params.max_cpus as int)
        } catch (all) {
            println "ERROR: Invalid max cpus '${params.max_cpus}'"
            return obj
        }
    }
}

// HLA extraction settings
params {
    enable_conda            = false
    enable_hla_extraction = false  // Set to true to enable pre-extraction
}
// --- PATCH: fixes invalid task.workDir config and improves robustness ---
report {
  overwrite = true
}
timeline {
  overwrite = true
}

process {
  withName: ARCASHLA_BAM {
    // Use a per-task temp directory instead of /tmp (prevents "No space left on device")
    env.TMPDIR = '$PWD/tmp'
  }
}
